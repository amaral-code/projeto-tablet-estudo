{
  "name": "Caderno de Estudos",
  "short_name": "Caderno",
  "description": "Caderno de estudos para tablet: escreva à mão, organize matérias, tarefas, agenda, flashcards, fórmulas e tire dúvidas com a IA.",
  "lang": "pt-BR",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "display_override": [
    "fullscreen",
    "standalone"
  ],
  "orientation": "any",
  "background_color": "#f4f5f7",
  "theme_color": "#1f6feb",
  "categories": [
    "education",
    "productivity"
  ],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/badge-96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "monochrome"
    },
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Hoje",
      "short_name": "Hoje",
      "url": "./?v=today",
      "icons": [
        {
          "src": "icons/sc-hoje.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Começar foco",
      "short_name": "Foco",
      "url": "./?v=focus&start=1",
      "icons": [
        {
          "src": "icons/sc-foco.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Nova anotação",
      "short_name": "Anotar",
      "url": "./?a=nova-anotacao",
      "icons": [
        {
          "src": "icons/sc-anotar.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Leitura e Kindle",
      "short_name": "Leitura",
      "url": "./?v=reading",
      "icons": [
        {
          "src": "icons/sc-leitura.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./compartilhar",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "arquivos",
          "accept": [
            "audio/*",
            "image/*",
            "application/pdf",
            ".m4a",
            ".mp3",
            ".aac",
            ".ogg",
            ".wav",
            ".amr",
            ".3gp",
            ".webm"
          ]
        }
      ]
    }
  }
}
